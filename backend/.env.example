# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Database (MongoDB) ----
# Local mongod:
MONGO_URI=mongodb://127.0.0.1:27017/research_tracker
# Or MongoDB Atlas (example):
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/research_tracker

# ---- Session ----
# Change this to a long random string in production.
SESSION_SECRET=change-this-to-a-long-random-secret

# ---- Email verification ----
# Public base URL of the app, used to build links inside emails (verify, reset,
# invite). In production this is your PUBLIC front-door origin — with the Vercel
# reverse-proxy setup that is your Vercel domain, e.g. https://pacher.vercel.app
APP_URL=http://localhost:3000

# Comma-separated origins the CSRF same-origin check should trust in addition to
# APP_URL. Needed when a reverse proxy (Vercel) forwards the browser Origin (your
# public site) while this backend sees its own Host (the Render service). Leave
# blank for local dev / all-in-one. Example: https://pacher.vercel.app
TRUSTED_ORIGINS=
# Outgoing mail. Three modes, in order of precedence:
#   1. Brevo HTTP API — set BREVO_API_KEY below. Sends over HTTPS (port 443), so it
#      works on hosts that block outbound SMTP (e.g. Render free). Recommended for prod.
#   2. SMTP — set SMTP_HOST (+ port/secure/user/pass). Used only if BREVO_API_KEY is
#      blank. Note: many free PaaS block outbound SMTP ports, so sends may hang/fail.
#   3. Console mode — both blank: verification links are printed to the server console
#      instead of emailed (local dev / offline demos).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# MAIL_FROM must be a sender you have VERIFIED in Brevo (or one your SMTP provider
# allows). A fake domain like pacher.local is rejected in production.
MAIL_FROM=Pacher <no-reply@pacher.local>
# Brevo transactional-email API key (starts with "xkeysib-"). When set, takes
# precedence over SMTP. Keep it secret — set it in the host's env, never in git.
BREVO_API_KEY=

# ---- S-BERT similarity service ----
# In production this is your S-BERT host — e.g. a Render web service URL like
# https://pacher-sbert.onrender.com
SBERT_URL=http://127.0.0.1:8000
SBERT_TIMEOUT_MS=4000
# Shared secret the backend presents to a PUBLIC S-BERT host (e.g. a free Render
# web service). Leave blank for local dev / a private S-BERT. Must exactly match
# the SBERT_KEY set as a secret on the S-BERT service.
SBERT_KEY=

# ---- Similarity warning thresholds (cosine similarity 0..1) ----
SIM_HIGH=0.80
SIM_MODERATE=0.60

# ---- Seed super-admin (created by `npm run seed`) ----
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@pacher.local
ADMIN_PASSWORD=Admin@12345
