# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Database (MongoDB) ----
# Local mongod:
MONGO_URI=mongodb://127.0.0.1:27017/research_tracker
# Or MongoDB Atlas (example):
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/research_tracker

# ---- Session ----
# Change this to a long random string in production.
SESSION_SECRET=change-this-to-a-long-random-secret

# ---- Email verification ----
# Public base URL of the app, used to build the verification link in emails.
APP_URL=http://localhost:3000
# SMTP settings for outgoing mail. Leave SMTP_HOST blank to run in "console mode"
# (verification links are printed to the server console instead of emailed).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pacher <no-reply@pacher.local>

# ---- S-BERT similarity service ----
SBERT_URL=http://127.0.0.1:8000
SBERT_TIMEOUT_MS=4000

# ---- Similarity warning thresholds (cosine similarity 0..1) ----
SIM_HIGH=0.80
SIM_MODERATE=0.60

# ---- Seed super-admin (created by `npm run seed`) ----
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@pacher.local
ADMIN_PASSWORD=Admin@12345
